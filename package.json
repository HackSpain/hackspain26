{
  "name": "hackspain",
  "private": true,
  "workspaces": ["apps/*"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun run --filter web dev",
    "dev:web": "bun run --filter web dev",
    "dev:app": "bun run --filter app dev",
    "dev:convex": "bun run --filter app convex:dev",
    "dev:all": "concurrently -k -n web,app,convex -c yellow,cyan,magenta \"bun run --filter web dev\" \"bun run --filter app dev\" \"bun run --filter app convex:dev\"",
    "build": "bun run --filter web build",
    "build:web": "bun run --filter web build",
    "build:app": "bun run --filter app build",
    "preview": "bun run --filter web preview",
    "check": "bun run --filter web check",
    "og:generate": "bun run --filter web og:generate",
    "assets:quiver": "bun run --filter web assets:quiver",
    "assets:quiver:tiles": "bun run --filter web assets:quiver:tiles",
    "assets:quiver:tiles+heroes": "bun run --filter web assets:quiver:tiles+heroes",
    "db:generate": "bun run --filter web db:generate",
    "db:migrate": "bun run --filter web db:migrate",
    "db:push": "bun run --filter web db:push",
    "astro": "bun run --filter web astro",
    "migrate:convex": "bun run --filter app migrate",
    "dev:cli": "bun run --filter cli dev",
    "build:cli": "bun run --filter cli build:bin",
    "test:cli": "bun run --filter cli test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
