{
  "name": "hackspain",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:app": "pnpm --filter app dev",
    "dev:api": "pnpm --filter api dev",
    "dev:convex": "pnpm --filter app convex:dev",
    "dev:all": "concurrently -k -n web,app,convex -c yellow,cyan,magenta \"pnpm --filter web dev\" \"pnpm --filter app dev\" \"pnpm --filter app convex:dev\"",
    "build": "pnpm --filter web build",
    "build:web": "pnpm --filter web build",
    "build:app": "pnpm --filter app build",
    "preview": "pnpm --filter web preview",
    "check": "pnpm --filter web check",
    "check:api": "pnpm --filter api check",
    "lint": "oxlint -c oxlint.config.mjs oxlint.config.mjs && pnpm --filter app lint && pnpm --filter web lint && pnpm --filter cli lint && pnpm --filter api lint",
    "fix": "oxlint -c oxlint.config.mjs --fix oxlint.config.mjs && pnpm --filter app fix && pnpm --filter web fix && pnpm --filter cli fix && pnpm --filter api fix",
    "deploy:api": "pnpm --filter api deploy",
    "og:generate": "pnpm --filter web og:generate",
    "assets:quiver": "pnpm --filter web assets:quiver",
    "assets:quiver:tiles": "pnpm --filter web assets:quiver:tiles",
    "assets:quiver:tiles+heroes": "pnpm --filter web assets:quiver:tiles+heroes",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:push": "pnpm --filter web db:push",
    "astro": "pnpm --filter web astro",
    "migrate:convex": "pnpm --filter app migrate",
    "dev:cli": "pnpm --filter cli dev",
    "build:cli": "pnpm --filter cli build:bin",
    "test:cli": "pnpm --filter cli test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxlint": "1.81.0",
    "ultracite": "7.6.2"
  }
}
