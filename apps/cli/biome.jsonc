{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "scripts/**",
      "!**/dist",
      "!**/node_modules",
      "!**/.cache",
      "!test/fixtures"
    ]
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": "error",
        // The CLI uses `type` aliases throughout, matching apps/app.
        "useConsistentTypeDefinitions": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "suspicious": {
        // A CLI's whole job is writing to stdout/stderr.
        "noConsole": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["test/**", "!test/fixtures"],
      "linter": {
        "rules": {
          "suspicious": {
            // Async stubs standing in for network calls rarely await anything.
            "useAwait": "off",
            // File-mode assertions mask with 0o777.
            "noBitwiseOperators": "off",
            // No-op callbacks for stubbed stores and sinks.
            "noEmptyBlockStatements": "off"
          },
          "performance": {
            // Inline `toMatch(/…/)` reads better than hoisted constants in tests.
            "useTopLevelRegex": "off"
          }
        }
      }
    }
  ]
}
