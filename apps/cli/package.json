{
  "name": "cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "hackspain: terminal client for HackSpain participants",
  "bin": {
    "hackspain": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "ultracite check",
    "fix": "ultracite fix",
    "test": "bun test",
    "build:bin:host": "bash scripts/build-all.sh --host",
    "build:bin": "bash scripts/build-all.sh"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/bun": "^1.3.0",
    "convex": "^1.25.4",
    "typescript": "^5",
    "ultracite": "7.6.2"
  }
}
