{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/astro",
    "ultracite/biome/react"
  ],
  "overrides": [
    {
      // Astro renders templates once and has no React reconciliation keys.
      // https://docs.astro.build/en/reference/astro-syntax/#differences-between-astro-and-jsx
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "useJsxKeyInIterable": "off"
          }
        }
      }
    },
    {
      "includes": ["src/pages/brand.astro"],
      "html": {
        "formatter": {
          "selfCloseVoidElements": "always"
        }
      }
    }
  ],
  "files": {
    "includes": ["!!drizzle/meta"]
  },
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": "error"
      },
      "performance": {
        "noBarrelFile": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      }
    }
  }
}
