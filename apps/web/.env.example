# Better Stack Errors uses the existing Sentry-compatible SDK. The DSN is public.
PUBLIC_BETTER_STACK_ERRORS_DSN=
# Source-map upload values from Errors -> application -> Advanced settings.
BETTER_STACK_API_TOKEN=
BETTER_STACK_ERRORS_ORG=
BETTER_STACK_ERRORS_PROJECT=
BETTER_STACK_SOURCEMAPS_URL=

# Optional search-engine ownership verification.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_YANDEX_SITE_VERIFICATION=

# Anonymous harness poll storage.
RAWTREE_API_KEY=
RAWTREE_DATABASE=
