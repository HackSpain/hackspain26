---
import data from "../data/insights-2026-community.json";
import geography from "../data/spain-regions.json";

const regions = data.regions.toSorted(
  (a, b) => b.count - a.count || a.name.localeCompare(b.name, "es")
);
function tone(count: number) {
  if (count === 0) {
    return "paper";
  }
  if (count < 5) {
    return "sand";
  }
  if (count < 15) {
    return "gold";
  }
  if (count < 40) {
    return "orange";
  }
  return "red";
}
const initial = regions[0];
---

<figure class="community-map" aria-labelledby="origins-heading">
  <header>
    <h3 id="origins-heading">
      Muchos puntos de partida. Un mismo fin de semana.
    </h3>
    <p>Ciudades declaradas por las {data.participants} personas con equipo</p>
  </header>
  <div class="map-layout">
    <svg
      viewBox={geography.viewBox}
      aria-label="Mapa de procedencia por comunidades autónomas"
    >
      <title>Mapa de procedencia por comunidades autónomas</title>
      {geography.regions.map((shape) => {
        const region = data.regions.find((r) => r.id === shape.id);
        if (!region) { throw new Error(`Missing region data: ${shape.id}`); }
        // biome-ignore lint/a11y/useSemanticElements: SVG paths have no native button equivalent; keyboard interaction is handled below.
        return <path aria-label={`${region.name}: ${region.count} ${region.count === 1 ? "persona" : "personas"}`} aria-pressed={region.id === initial.id} d={shape.path} data-region={region.id} fill={`var(--color-hs-${tone(region.count)})`} role="button" tabindex="0"><title>{region.name}: {region.count}</title></path>;
      })}
      <path class="inset" d="M20 503H272V647H20Z" />
      <text x="32" y="529">Canarias</text>
    </svg>
    <div class="map-detail">
      <label for="origin-region">Explorar una comunidad</label>
      <select id="origin-region">
        {regions.map((r) => <option value={r.id}>{r.name} · {r.count}</option>)}
      </select>
      {regions.map((region) => <div class="region-detail" data-region-detail={region.id} hidden={region.id !== initial.id}>
        <p class="region-total"><strong>{region.count}</strong> <span>de {data.participants} personas</span></p>
        <h4>{region.name}</h4>
        <ul>{region.cities.map((city) => <li><span>{city.name}</span><strong>{city.count}</strong></li>)}</ul>
        {region.count === 0 && <p>No hay ciudades declaradas de esta comunidad en este grupo.</p>}
      </div>)}
      <p class="beyond">
        También hubo ciudades fuera de España: Andorra, Berna y París, con una
        persona cada una.
      </p>
    </div>
  </div>
  <div class="map-legend" aria-label="Escala de personas por comunidad">
    {[{label:"0",count:0},{label:"1–4",count:1},{label:"5–14",count:5},{label:"15–39",count:15},{label:"40+",count:40}].map((item) => <span><i style={`background:var(--color-hs-${tone(item.count)})`} />{item.label}</span>)}
    personas
  </div>
  <figcaption>
    La ciudad del perfil indica procedencia, no el lugar de nacimiento. Hay 250
    personas situadas en España, tres fuera y una ciudad sin asignar por ser
    ambigua. Canarias se muestra en un recuadro.
    <a href={geography.source} target="_blank" rel="noopener noreferrer"
      >Cartografía: Ministerio de Transportes</a
    >.
  </figcaption>
  <details>
    <summary>Ver todas las comunidades y ciudades</summary>
    <ul class="all-regions">
      {regions.map((r) => <li><strong>{r.name}: {r.count}</strong>{r.cities.length > 0 && <span>{r.cities.map((c) => `${c.name} (${c.count})`).join(" · ")}</span>}</li>)}
    </ul>
  </details>
</figure>
<script>
  const map = document.querySelector<HTMLElement>(".community-map");
  const select = map?.querySelector<HTMLSelectElement>("select");
  if (map && select) {
    const choose = (id: string) => {
      select.value = id;
      for (const panel of map.querySelectorAll<HTMLElement>(
        "[data-region-detail]"
      )) {
        panel.hidden = panel.dataset.regionDetail !== id;
      }
      for (const path of map.querySelectorAll<SVGPathElement>(
        "[data-region]"
      )) {
        path.setAttribute("aria-pressed", String(path.dataset.region === id));
      }
    };
    select.addEventListener("change", () => choose(select.value));
    for (const path of map.querySelectorAll<SVGPathElement>("[data-region]")) {
      const id = path.dataset.region;
      if (!id) {
        throw new Error("Map region is missing its identifier");
      }
      path.addEventListener("click", () => choose(id));
      path.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          choose(id);
        }
      });
    }
  }
</script>
<style>
  .community-map {
    width: min(100% - 40px, 900px);
    margin: 40px auto 0;
    color: var(--color-hs-ink);
    border: 3px solid var(--color-hs-ink);
  }
  header {
    padding: 16px 20px;
    border-bottom: 3px solid var(--color-hs-ink);
  }
  h3 {
    margin: 0;
    font: 800 18px / 1.3 var(--font-sans);
    text-wrap: balance;
  }
  header p,
  figcaption,
  .beyond,
  details,
  label,
  select,
  .map-legend {
    font: 600 14px / 1.5 var(--font-sans);
  }
  header p {
    margin: 8px 0 0;
    color: var(--color-hs-brown);
  }
  .map-layout {
    display: grid;
    grid-template-columns: 1.65fr 1fr;
    gap: 20px;
    align-items: center;
    padding: 12px 20px 0;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 360px;
    overflow: visible;
  }
  svg path[data-region] {
    cursor: pointer;
    stroke: var(--color-hs-ink);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  svg path[aria-pressed="true"] {
    stroke-width: 3;
  }
  svg path:focus-visible {
    outline: none;
    stroke: var(--color-hs-navy);
    stroke-width: 4;
  }
  .inset {
    fill: none;
    stroke: var(--color-hs-brown);
    stroke-dasharray: 4 4;
  }
  svg text {
    font: 700 13px var(--font-sans);
    fill: var(--color-hs-ink);
  }
  label {
    display: block;
    margin-bottom: 6px;
    font-weight: 800;
  }
  select {
    width: 100%;
    min-height: 44px;
    padding: 8px;
    color: inherit;
    background: var(--color-hs-paper);
    border: 2px solid var(--color-hs-ink);
    border-radius: 0;
  }
  .region-detail[hidden] {
    display: none;
  }
  .region-detail {
    min-height: 180px;
  }
  .region-total {
    display: flex;
    gap: 10px;
    align-items: baseline;
    margin: 16px 0 8px;
  }
  .region-total > strong {
    font: 40px / 1 var(--font-bungee);
  }
  .region-total span {
    font-size: 14px;
  }
  h4 {
    margin: 0 0 12px;
    font-size: 18px;
  }
  ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .region-detail li {
    display: flex;
    gap: 12px;
    justify-content: space-between;
    padding: 6px 0;
    font-size: 14px;
    border-bottom: 1px solid var(--color-hs-sand);
  }
  .beyond {
    margin: 12px 0;
    color: var(--color-hs-brown);
  }
  .map-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    padding: 8px 20px;
  }
  .map-legend span {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
  .map-legend i {
    width: 16px;
    height: 16px;
    border: 1px solid var(--color-hs-ink);
  }
  figcaption {
    padding: 8px 20px 12px;
    margin: 0;
    color: var(--color-hs-brown);
  }
  figcaption a {
    text-decoration: underline;
  }
  details {
    padding: 0 20px 12px;
  }
  summary {
    align-content: center;
    min-height: 44px;
    font-weight: 800;
    cursor: pointer;
  }
  .all-regions {
    columns: 2;
  }
  .all-regions li {
    padding: 8px 0;
    break-inside: avoid;
  }
  .all-regions span {
    display: block;
    color: var(--color-hs-brown);
  }
  select:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--color-hs-navy);
    outline-offset: 3px;
  }
  @media (max-width: 700px) {
    .community-map {
      width: calc(100% - 28px);
    }
    .map-layout {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 12px 16px 0;
    }
    header {
      padding: 14px 16px;
    }
    h3 {
      font-size: 18px;
    }
    svg {
      max-height: 260px;
    }
    .region-detail {
      min-height: 0;
    }
    figcaption,
    details {
      padding-inline: 16px;
    }
    .map-legend {
      gap: 10px;
      padding-inline: 16px;
    }
    .all-regions {
      columns: 1;
    }
    select {
      font-size: 16px;
    }
  }
</style>
