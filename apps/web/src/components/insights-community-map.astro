---
import data from "../data/insights-2026-community.json";
import geography from "../data/spain-regions.json";
const regions = data.regions.toSorted((a, b) => b.count - a.count || a.name.localeCompare(b.name, "es"));
const tone = (count: number) => count === 0 ? "paper" : count < 5 ? "sand" : count < 15 ? "gold" : count < 40 ? "orange" : "red";
const initial = regions[0];
---
<figure class="community-map" aria-labelledby="origins-heading">
  <header><h3 id="origins-heading">Muchos puntos de partida. Un mismo fin de semana.</h3><p>Ciudades declaradas por las {data.participants} personas con equipo</p></header>
  <div class="map-layout">
    <svg viewBox={geography.viewBox} aria-label="Mapa de procedencia por comunidades autónomas">
      {geography.regions.map((shape) => {
        const region = data.regions.find((r) => r.id === shape.id)!;
        return <path d={shape.path} fill={`var(--color-hs-${tone(region.count)})`} data-region={region.id} role="button" tabindex="0" aria-label={`${region.name}: ${region.count} ${region.count === 1 ? "persona" : "personas"}`} aria-pressed={region.id === initial.id}><title>{region.name}: {region.count}</title></path>;
      })}
      <path class="inset" d="M20 503H272V647H20Z" />
      <text x="32" y="529">Canarias</text>
    </svg>
    <div class="map-detail">
      <label for="origin-region">Explorar una comunidad</label>
      <select id="origin-region">{regions.map((r) => <option value={r.id}>{r.name} · {r.count}</option>)}</select>
      {regions.map((region) => <div class="region-detail" data-region-detail={region.id} hidden={region.id !== initial.id}>
        <p class="region-total"><strong>{region.count}</strong> <span>de {data.participants} personas</span></p>
        <h4>{region.name}</h4>
        <ul>{region.cities.map((city) => <li><span>{city.name}</span><strong>{city.count}</strong></li>)}</ul>
        {region.count === 0 && <p>No hay ciudades declaradas de esta comunidad en este grupo.</p>}
      </div>)}
      <p class="beyond">También hubo ciudades fuera de España: Andorra, Berna y París, con una persona cada una.</p>
    </div>
  </div>
  <div class="map-legend" aria-label="Escala de personas por comunidad">{[{label:"0",count:0},{label:"1–4",count:1},{label:"5–14",count:5},{label:"15–39",count:15},{label:"40+",count:40}].map((item) => <span><i style={`background:var(--color-hs-${tone(item.count)})`}></i>{item.label}</span>)} personas</div>
  <figcaption>La ciudad del perfil indica procedencia, no el lugar de nacimiento. Hay 250 personas situadas en España, tres fuera y una ciudad sin asignar por ser ambigua. Canarias se muestra en un recuadro. <a href={geography.source} target="_blank" rel="noopener noreferrer">Cartografía: Ministerio de Transportes</a>.</figcaption>
  <details><summary>Ver todas las comunidades y ciudades</summary><ul class="all-regions">{regions.map((r) => <li><strong>{r.name}: {r.count}</strong>{r.cities.length > 0 && <span>{r.cities.map((c) => `${c.name} (${c.count})`).join(" · ")}</span>}</li>)}</ul></details>
</figure>
<script>
  const map = document.querySelector<HTMLElement>(".community-map");
  const select = map?.querySelector<HTMLSelectElement>("select");
  if (map && select) {
    const choose = (id: string) => {
      select.value = id;
      map.querySelectorAll<HTMLElement>("[data-region-detail]").forEach((panel) => { panel.hidden = panel.dataset.regionDetail !== id; });
      map.querySelectorAll("[data-region]").forEach((path) => { path.setAttribute("aria-pressed", String(path.getAttribute("data-region") === id)); });
    };
    select.addEventListener("change", () => choose(select.value));
    map.querySelectorAll<SVGPathElement>("[data-region]").forEach((path) => {
      path.addEventListener("click", () => choose(path.dataset.region!));
      path.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") { event.preventDefault(); choose(path.dataset.region!); }
      });
    });
  }
</script>
<style>
  .community-map { width: min(100% - 40px, 900px); margin: 40px auto 0; border: 3px solid var(--color-hs-ink); color: var(--color-hs-ink); }
  header { padding: 16px 20px; border-bottom: 3px solid var(--color-hs-ink); }
  h3 { margin: 0; font: 800 18px/1.3 var(--font-sans); text-wrap: balance; }
  header p, figcaption, .beyond, details, label, select, .map-legend { font: 600 14px/1.5 var(--font-sans); }
  header p { margin: 8px 0 0; color: var(--color-hs-brown); }
  .map-layout { display: grid; grid-template-columns: 1.65fr 1fr; align-items: center; gap: 20px; padding: 12px 20px 0; }
  svg { display: block; width: 100%; max-height: 360px; height: auto; overflow: visible; }
  svg path[data-region] { stroke: var(--color-hs-ink); stroke-width: 1; stroke-linejoin: round; cursor: pointer; }
  svg path[aria-pressed="true"] { stroke-width: 3; }
  svg path:focus-visible { outline: none; stroke: var(--color-hs-navy); stroke-width: 4; }
  .inset { fill: none; stroke: var(--color-hs-brown); stroke-dasharray: 4 4; }
  svg text { fill: var(--color-hs-ink); font: 700 13px var(--font-sans); }
  label { display: block; margin-bottom: 6px; font-weight: 800; }
  select { width: 100%; min-height: 44px; border: 2px solid var(--color-hs-ink); background: var(--color-hs-paper); color: inherit; padding: 8px; border-radius: 0; }
  .region-detail[hidden] { display: none; }
  .region-detail { min-height: 180px; }
  .region-total { margin: 16px 0 8px; display: flex; align-items: baseline; gap: 10px; }
  .region-total > strong { font: 40px/1 var(--font-bungee); }
  .region-total span { font-size: 14px; }
  h4 { font-size: 18px; margin: 0 0 12px; }
  ul { list-style: none; padding: 0; margin: 0; }
  .region-detail li { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-bottom: 1px solid var(--color-hs-sand); font-size: 14px; }
  .beyond { margin: 12px 0; color: var(--color-hs-brown); }
  .map-legend { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; padding: 8px 20px; }
  .map-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .map-legend i { width: 16px; height: 16px; border: 1px solid var(--color-hs-ink); }
  figcaption { margin: 0; padding: 8px 20px 12px; color: var(--color-hs-brown); }
  figcaption a { text-decoration: underline; }
  details { padding: 0 20px 12px; }
  summary { cursor: pointer; min-height: 44px; align-content: center; font-weight: 800; }
  .all-regions { columns: 2; }
  .all-regions li { break-inside: avoid; padding: 8px 0; }
  .all-regions span { display: block; color: var(--color-hs-brown); }
  select:focus-visible, summary:focus-visible { outline: 2px solid var(--color-hs-navy); outline-offset: 3px; }
  @media(max-width:700px) { .community-map { width: calc(100% - 28px); } .map-layout { grid-template-columns: 1fr; gap: 0; padding: 12px 16px 0; } header { padding: 14px 16px; } h3 { font-size: 18px; } svg { max-height: 260px; } .region-detail { min-height: 0; } figcaption, details { padding-inline: 16px; } .map-legend { padding-inline: 16px; gap: 10px; } .all-regions { columns: 1; } select { font-size: 16px; } }
</style>
