---
import { FINAL_AWARD_JUDGES, GENERAL_JUDGES } from "../../data/judges";
import { MENTORS } from "../../data/mentors";
import { communityPosts } from "../../data/recap";
import { SECTION_SLUGS } from "../../data/section-routes";
import { TRACK_SPONSORS_DETAIL } from "../../data/track-sponsors";

interface Props {
  sectionIndex: number;
}

const { sectionIndex } = Astro.props;
const slug = sectionIndex === 0 ? "inicio" : SECTION_SLUGS[sectionIndex - 1];
const pages = [
  { href: "/", label: "La edición" },
  { href: "/comunidad", label: "Comunidad" },
  { href: "/mission", label: "Misión" },
  { href: "/tracks", label: "Tracks" },
  { href: "/infra", label: "Infraestructura" },
  { href: "/gran-premio", label: "Gran premio" },
  { href: "/mentores", label: "Mentores" },
  { href: "/apuntate", label: "Inscripción" },
  { href: "/patrocina", label: "Colabora" },
];
const intro: Record<string, { eyebrow: string; title: string; lead: string }> =
  {
    inicio: {
      eyebrow: "18–20 septiembre 2026 · Madrid",
      title:
        "HackSpain 2026: así fue el hackathon de jóvenes builders en Madrid",
      lead: "Durante 36 horas, 250 participantes menores de 30 años se reunieron en la ETSIT de la Universidad Politécnica de Madrid para construir productos en cinco tracks propuestos por startups.",
    },
    comunidad: {
      eyebrow: "La comunidad · HackSpain 2026",
      title: "Las historias de la comunidad HackSpain",
      lead: "La edición terminó el 20 de septiembre de 2026. Aquí reunimos el vídeo del evento y publicaciones de personas que participaron o nos visitaron.",
    },
    mission: {
      eyebrow: "Nuestra misión",
      title: "Reunir a los jóvenes que construyen tecnología en España",
      lead: "HackSpain reunió a 250 builders menores de 30 años para crear juntos durante un fin de semana y conectar con fundadores, mentores e inversores del ecosistema español.",
    },
    tracks: {
      eyebrow: "Cinco startups · Cinco tracks",
      title: "Los tracks y las startups de HackSpain 2026",
      lead: "Maisa, HappyRobot, Prosper AI, Embat y THEKER Robotics llevaron sus retos a la edición de Madrid. Estos fueron los equipos detrás de los cinco tracks.",
    },
    infra: {
      eyebrow: "Herramientas para construir",
      title: "La infraestructura de HackSpain 2026",
      lead: "Los equipos tuvieron acceso a herramientas y compute con el apoyo de diez compañías de infraestructura y software.",
    },
    "gran-premio": {
      eyebrow: "Premio de la edición 2026",
      title: "El gran premio de 5.000 € y el jurado de HackSpain",
      lead: "La edición contó con un gran premio de 5.000 € para un equipo ganador y dos paneles de jurado: el de la final y el general.",
    },
    mentores: {
      eyebrow: "Personas del ecosistema",
      title: "Fundadores y mentores de HackSpain 2026",
      lead: "Fundadores, operadores e ingenieros acompañaron a los equipos durante el fin de semana en Madrid.",
    },
    apuntate: {
      eyebrow: "Edición 2026 finalizada",
      title: "La inscripción a HackSpain 2026 está cerrada",
      lead: "HackSpain 2026 se celebró del 18 al 20 de septiembre en Madrid. Sigue los canales oficiales para conocer las novedades sobre futuras ediciones.",
    },
  };
const current = intro[slug] ?? intro.inicio;
const infrastructure = [
  "Convex",
  "Vercel",
  "QuiverAI",
  "Cloudflare",
  "Tinybird",
  "Cognition",
  "Exa",
  "fal.ai",
  "Cursor",
  "Helmcode",
];
---

<section
  id="edicion-2026"
  class="w-full border-hs-ink border-t-[3px] bg-hs-paper px-4 py-12 text-hs-ink sm:px-6 sm:py-16"
>
  <div class="mx-auto max-w-5xl">
    <p
      class="font-sans font-black text-hs-red text-xs uppercase tracking-[0.16em]"
    >
      {current.eyebrow}
    </p>
    <h1
      class="mt-3 max-w-4xl text-balance font-bungee text-[clamp(2rem,5vw,3.5rem)] leading-tight"
    >
      {current.title}
    </h1>
    <p
      class="mt-5 max-w-3xl text-pretty font-bold font-sans text-lg leading-relaxed sm:text-xl"
    >
      {current.lead}
    </p>

    <nav
      aria-label="Explorar HackSpain"
      class="mt-10 border-[3px] border-hs-ink bg-hs-ink p-[3px]"
    >
      <ul class="grid grid-cols-2 gap-[3px] sm:grid-cols-3">
        {pages.map((page) => (
          // biome-ignore lint/correctness/useJsxKeyInIterable: Astro renders plain HTML.
          <li>
            <a aria-current={(slug === "inicio" ? "/" : `/${slug}`) === page.href ? "page" : undefined} class="flex min-h-12 items-center bg-hs-sand px-3 py-2 font-extrabold font-sans text-hs-ink text-sm transition-colors duration-150 hover:bg-hs-gold focus-visible:outline-2 focus-visible:outline-hs-navy focus-visible:outline-offset-[-2px] aria-[current=page]:bg-hs-gold" href={page.href}>{page.label} <span aria-hidden="true" class="ml-auto">↗</span></a>
          </li>
        ))}
      </ul>
    </nav>

    {slug === "inicio" && (
      <div class="mt-12 grid gap-[3px] border-[3px] border-hs-ink bg-hs-ink md:grid-cols-3">
        <article class="bg-hs-gold p-6"><h2 class="font-bungee text-xl">36 horas</h2><p class="mt-2 font-sans font-semibold">Para idear, construir y presentar un producto.</p></article>
        <article class="bg-hs-sand p-6"><h2 class="font-bungee text-xl">250 builders</h2><p class="mt-2 font-sans font-semibold">Jóvenes menores de 30 años de toda España.</p></article>
        <article class="bg-hs-teal p-6 text-hs-paper"><h2 class="font-bungee text-xl">Cinco tracks</h2><p class="mt-2 font-sans font-semibold">Retos impulsados por startups tecnológicas.</p></article>
      </div>
    )}

    {slug === "comunidad" && (
      <div class="mt-12">
        <h2 class="font-bungee text-2xl">Revive el fin de semana</h2>
        <a class="mt-4 block max-w-xl border-[3px] border-hs-ink bg-hs-ink text-hs-paper focus-visible:outline-2 focus-visible:outline-hs-navy focus-visible:outline-offset-2" href="/recap/hackspain-2026.mp4">
          <img alt="Participantes de HackSpain en la ETSIT de Madrid" class="aspect-video w-full object-cover" decoding="async" height="720" loading="lazy" src="/recap/poster.jpg" width="1280" />
          <span class="block px-5 py-3 font-bold font-sans underline underline-offset-4">Ver el vídeo de HackSpain 2026 ↗</span>
        </a>
        <h2 class="mt-12 font-bungee text-2xl">Publicaciones de la comunidad</h2>
        <ul class="mt-5 grid gap-[3px] border-[3px] border-hs-ink bg-hs-ink sm:grid-cols-2">
          {communityPosts.map((post) => (
            // biome-ignore lint/correctness/useJsxKeyInIterable: Astro renders plain HTML.
            <li class="bg-hs-sand p-5"><a class="font-extrabold font-sans underline underline-offset-4 hover:text-hs-red" href={post.url} rel="noopener noreferrer" target="_blank">{post.author} · @{post.handle} ↗</a></li>
          ))}
        </ul>
      </div>
    )}

    {slug === "mission" && (
      <div class="mt-12 max-w-3xl space-y-5 font-sans font-semibold text-lg leading-relaxed">
        <p>La misión de HackSpain es reunir a personas con ganas de construir y darles tiempo, herramientas y compañía para convertir ideas en productos. La edición de 2026 tuvo lugar en la ETSIT de la Universidad Politécnica de Madrid.</p>
        <p>Los equipos trabajaron en retos de startups españolas, recibieron ayuda de mentores y presentaron lo construido durante el evento.</p>
      </div>
    )}

    {slug === "tracks" && (
      <div class="mt-12">
        <h2 class="font-bungee text-2xl">Las cinco startups</h2>
        <div class="mt-5 grid gap-[3px] border-[3px] border-hs-ink bg-hs-ink sm:grid-cols-2">
          {TRACK_SPONSORS_DETAIL.map((sponsor) => (
            // biome-ignore lint/correctness/useJsxKeyInIterable: Astro renders plain HTML.
            <article class="bg-hs-sand p-5 sm:p-6" id={`track-${sponsor.id}`}>
              <h3 class="font-bungee text-xl">{sponsor.name}</h3>
              <p class="mt-2 font-bold font-sans text-hs-brown">{sponsor.tagline}</p>
              <p class="mt-3 font-sans font-semibold leading-relaxed">{sponsor.description}</p>
            </article>
          ))}
        </div>
      </div>
    )}

    {slug === "infra" && (
      <div class="mt-12">
        <h2 class="font-bungee text-2xl">Compañías de infraestructura</h2>
        <p class="mt-3 max-w-3xl font-sans font-semibold leading-relaxed">Estas compañías apoyaron a los equipos con herramientas para desarrollar sus proyectos durante la edición de 2026.</p>
        <ul class="mt-5 grid gap-[3px] border-[3px] border-hs-ink bg-hs-ink sm:grid-cols-2 lg:grid-cols-5">
          {infrastructure.map((name) => (
            // biome-ignore lint/correctness/useJsxKeyInIterable: Astro renders plain HTML.
            <li class="bg-hs-sand p-4 font-extrabold font-sans">{name}</li>
          ))}
        </ul>
      </div>
    )}

    {slug === "gran-premio" && (
      <div class="mt-12 grid gap-10 lg:grid-cols-2">
        <section aria-labelledby="jurado-final">
          <h2 class="font-bungee text-2xl" id="jurado-final">Jurado de la final</h2>
          <ul class="mt-4 border-[3px] border-hs-ink">
            {FINAL_AWARD_JUDGES.map((judge) => (
              // biome-ignore lint/correctness/useJsxKeyInIterable: Astro renders plain HTML.
              <li class="border-hs-ink border-b-[3px] bg-hs-sand p-4 font-bold font-sans last:border-b-0">{judge.name} · {judge.company}</li>
            ))}
          </ul>
        </section>
        <section aria-labelledby="jurado-general">
          <h2 class="font-bungee text-2xl" id="jurado-general">Jurado general</h2>
          <ul class="mt-4 border-[3px] border-hs-ink">
            {GENERAL_JUDGES.map((judge) => (
              // biome-ignore lint/correctness/useJsxKeyInIterable: Astro renders plain HTML.
              <li class="border-hs-ink border-b-[3px] bg-hs-sand p-4 font-bold font-sans last:border-b-0">{judge.name} · {judge.company}</li>
            ))}
          </ul>
        </section>
      </div>
    )}

    {slug === "mentores" && (
      <div class="mt-12">
        <h2 class="font-bungee text-2xl">Mentores de la edición</h2>
        <div class="mt-5 grid gap-[3px] border-[3px] border-hs-ink bg-hs-ink sm:grid-cols-2 lg:grid-cols-3">
          {MENTORS.map((mentor) => (
            // biome-ignore lint/correctness/useJsxKeyInIterable: Astro renders plain HTML.
            <article class="bg-hs-sand p-5">
              <h3 class="font-bungee text-lg">{mentor.name}</h3>
              <p class="mt-2 font-bold font-sans text-hs-brown">{mentor.role}</p>
              <p class="mt-3 font-sans font-semibold leading-relaxed">{mentor.description}</p>
            </article>
          ))}
        </div>
      </div>
    )}

    {slug === "apuntate" && (
      <div class="mt-12 max-w-3xl border-[3px] border-hs-ink bg-hs-sand p-6"><h2 class="font-bungee text-2xl">Qué ocurrió en 2026</h2><p class="mt-3 font-sans font-semibold leading-relaxed">250 jóvenes participaron en Madrid durante 36 horas. Puedes explorar los cinco tracks, los mentores y las historias de la comunidad en las páginas de esta edición.</p><p class="mt-4 font-sans font-semibold">Las próximas convocatorias se anunciarán en los canales oficiales de HackSpain.</p></div>
    )}
  </div>
</section>
