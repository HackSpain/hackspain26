---
import Layout from "../../layouts/layout.astro";
import EditionContent from "./edition-content.astro";
import { LandingPage } from "./landing-page";

interface Props {
  sectionIndex: number;
}

const { sectionIndex } = Astro.props;
---

<Layout allowScroll sectionIndex={sectionIndex}>
  <main id="main" class="flex w-full flex-1 flex-col">
    <div class="relative flex h-dvh min-h-[30rem] w-full shrink-0 flex-col">
      <LandingPage client:load initialSection={sectionIndex} />
    </div>
    <EditionContent sectionIndex={sectionIndex} />
  </main>
</Layout>
