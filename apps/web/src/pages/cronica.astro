---
export const prerender = true;

import Layout from "../layouts/layout.astro";
import InsightsOpening from "../components/insights-opening.astro";
import CommunityMap from "../components/insights-community-map.astro";
import CommunityProfiles from "../components/insights-community-profiles.astro";
// The additional community charts use a separate, frozen HackSpain 2026
// snapshot in insights-2026-community.json. Never refresh it automatically.
// AGENTS: this recap contains the final historical snapshot of HackSpain 2026,
// held on September 18–20, 2026. These event data are already recorded and
// versioned. Do not modify, recalculate, regenerate, sync, or update these
// figures or insights-2026.json and insights-2026-charts.json, even if RawTree,
// Convex, or another source returns different values. These are not live data.
import insightData from "../data/insights-2026.json";
import chartData from "../data/insights-2026-charts.json";

const number = (value: number) => new Intl.NumberFormat("es-ES").format(value);
const requestShare = (value: number) => {
  const percent = Math.round((value / insightData.totals.requests) * 100);
  return percent === 0 && value > 0 ? "<1 %" : `${percent} %`;
};
const dateTime = (value: number, options: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat("es-ES", { timeZone: "Europe/Madrid", ...options }).format(value);

const { totals, buckets, models, stacks } = insightData;
const tokenBillions = new Intl.NumberFormat("es-ES", { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(totals.tokens / 1_000_000_000);
const modelCoverage = Math.round((models.reduce((sum, model) => sum + model.requests, 0) / totals.requests) * 100);
const modelFamily: Record<string, string> = { claude: "Claude", gpt: "GPT", gemini: "Gemini", qwen: "Qwen", other: "Otras" };
const displayModel = (name: string) => ({
  "claude-opus-5": "Claude Opus 5", "gpt-6-astra": "GPT-6 Astra", "gpt-5-6-sol": "GPT-5.6 Sol",
  "claude-fable-5-1": "Claude Fable 5.1", "claude-sonnet-5": "Claude Sonnet 5",
  "glm5-3": "GLM 5.3", "gpt-5-6-luna": "GPT-5.6 Luna",
  "deepseek-v4-1-flash": "DeepSeek V4.1 Flash", "deepseek-v4-flash": "DeepSeek V4 Flash",
  "gemini-3-8-flash": "Gemini 3.8 Flash", "claude-opus-5-medium": "Claude Opus 5 Medium",
  "gpt-6-astra-medium": "GPT-6 Astra Medium",
} as Record<string, string>)[name] ?? name;
const displayFamily = (model: { name: string; family: string }) =>
  model.name.startsWith("glm") ? "GLM" : model.name.startsWith("deepseek") ? "DeepSeek" : modelFamily[model.family] ?? model.family;
const chartWidth = 880;
const chartHeight = 240;
const chartLeft = 48;
const chartTop = 20;
const chartMax = Math.max(...buckets.map((bucket) => bucket.requests));
const chartPoints = buckets.map((bucket, index) => ({
  x: chartLeft + (index * chartWidth) / (buckets.length - 1),
  y: chartTop + chartHeight * (1 - bucket.requests / chartMax),
}));
const chartLine = chartPoints.map((point) => `${point.x},${point.y}`).join(" ");
const chartArea = `${chartLeft},${chartTop + chartHeight} ${chartLine} ${chartLeft + chartWidth},${chartTop + chartHeight}`;
const peakIndex = buckets.findIndex((bucket) => bucket.requests === chartMax);
const bucketDuration = (insightData.window.endsAt - insightData.window.startsAt) / buckets.length;
const peakStartsAt = insightData.window.startsAt + peakIndex * bucketDuration;
const chartTicks = [0, 5, 10, 15, 20, 23].map((index) => ({
  index,
  x: chartPoints[index].x,
  label: dateTime(insightData.window.startsAt + index * bucketDuration, {
    day: "numeric", hour: "2-digit", minute: "2-digit",
  }),
}));
const publishedAt = dateTime(insightData.snapshotAt, { day: "numeric", month: "long", year: "numeric" });

const stats = [
  { value: "250+", label: "participantes", detail: `${number(insightData.teams)} equipos construyendo en Madrid` },
  { value: number(totals.pullRequests), label: "pull requests", detail: `${number(totals.pushes)} pushes durante el fin de semana` },
  { value: tokenBillions, label: "mil millones de tokens", detail: "procesados por IA, incluida la caché" },
  { value: number(totals.sessions), label: "sesiones con agentes", detail: "de la primera idea a la última demo" },
];

const trackWinners = [
  {
    track: "Maisa",
    project: "trace-it",
    description: "Convierte normas de empresa en decisiones explicables sobre facturas y escala los casos dudosos.",
    source: "https://es.linkedin.com/posts/martinhdeez_hackspain2026-hackathon-traceit-activity-7507501388696965120-JiCl",
  },
  {
    track: "HappyRobot",
    project: "Drones para gestionar incendios",
    description: "Un sistema de agentes y drones para coordinar la respuesta ante incendios.",
    source: "https://es.linkedin.com/posts/guillermo-villar-sanchez_ya-ha-terminado-hackspain-2026-todav%C3%ADa-activity-7508204342785613826-Da3Z",
  },
  {
    track: "Prosper AI",
    project: "Vortex",
    description: "Un agente de voz para clínicas que atiende llamadas, gestiona citas y detecta cuándo debe intervenir una persona.",
    source: "https://es.linkedin.com/posts/joaquin-ferreiros_ganamos-el-track-de-prosper-ai-en-hackspain-activity-7507738917543088128-yHFZ",
  },
  {
    track: "Embat",
    project: "Kima",
    description: "Analiza cobros, pagos, liquidez y deuda para explicar la salud financiera de una empresa.",
    source: "https://es.linkedin.com/posts/martingarcialucas_hackspain-theexponentialfellowship-hackathon-activity-7508565628950085633-WgcJ",
  },
  {
    track: "THEKER Robotics",
    project: "STACKSPECT",
    description: "Simula una celda robotizada que pesa y coloca paquetes para formar palés estables.",
    source: "https://es.linkedin.com/posts/jose-manuel-amestoy-l%C3%B3pez-5a849629a_hackspain-theker-hackathon-activity-7507840280725716993-5_7x",
  },
];

const toolNames: Record<string, string> = {
  "claude-code": "Claude Code", codex: "Codex", cursor: "Cursor", devin: "Devin",
  opencode: "OpenCode", pi: "Pi", omp: "OMP", antigravity: "Antigravity",
  copilot: "Copilot", "gemini-cli": "Gemini CLI",
};
const { modelLabels, modelToolMatrix } = chartData;
const matrixPercent = (count: number, total: number) => {
  const share = (count / total) * 100;
  return count === 0 ? "—" : share < 1 ? "<1 %" : `${Math.round(share)} %`;
};
const matrixTint = (count: number, total: number) =>
  count === 0 ? 0 : Math.round(12 + (count / total) * 58);
---

<Layout
  allowScroll
  canonicalPathOverride="/cronica"
  description="Así fue HackSpain 2026: 250 jóvenes, cinco tracks, grandes mentores, premios por track y una final entre los proyectos del fin de semana."
  includeStructuredData={false}
  keywordsOverride="HackSpain 2026, crónica hackathon Madrid, resultados HackSpain, datos hackathon, proyectos, GitHub, IA"
  ogImageAlt="HackSpain 2026 — Madrid, 18 al 20 de septiembre"
  title="Así fue HackSpain 2026 | HackSpain"
>
  <main id="main" class="article-page">
    <article>
      <InsightsOpening />

      <section id="cronica" class="stats-section wide-width" aria-labelledby="numbers-heading">
        <div class="section-kicker"><h2 id="numbers-heading">Un fin de semana, de un vistazo</h2></div>
        <div class="stats-grid">
          {stats.map((stat) => <div class="stat"><strong>{stat.value}</strong><span>{stat.label}</span><p>{stat.detail}</p></div>)}
        </div>
      </section>

      <div class="reading-width prose intro">
        <div class="byline"><span>By Samuel Cordero</span><time datetime="2026-09-24">{publishedAt}</time></div>
        <p>El viernes llegaron con ideas. El domingo se fueron con proyectos, nuevos compañeros y ganas de seguir construyendo. Más de 250 jóvenes, 60 equipos y un fin de semana en Madrid que dio para mucho más que escribir código.</p>
        <p>La semilla de HackSpain la plantaron <strong>Leonardo Ollero, con 18 años, y Samuel Cordero, con 15</strong>. Se aliaron con <a href="https://goexponential.org" target="_blank" rel="noopener noreferrer">The Exponential Fellowship</a> para convertirla en un encuentro entre jóvenes, startups, mentores e inversores. En esta primera edición participaron más de 50 mentores y una veintena de voluntarios. Lo que vino después fue tan importante como los proyectos: conversaciones, ayuda entre equipos y una comunidad que empezó a reconocerse en persona.</p>
        <p>Madrid puso el punto de encuentro. Los equipos trajeron ciudades de <strong>16 comunidades autónomas</strong>, además de Andorra, Berna y París. Había gente que jugaba en casa y gente que había cruzado buena parte del mapa para pasar ese fin de semana construyendo.</p>
      </div>

      <CommunityMap />

      <section class="reading-width prose chapter" aria-labelledby="start-heading">
        <h2 id="start-heading">El viernes había cinco tracks y muchas formas de empezar.</h2>
        <p>Maisa, HappyRobot, Prosper AI, Embat y THEKER Robotics propusieron los cinco tracks. Cada equipo escogió por dónde empezar y qué quería enseñar el domingo.</p>
        <p>Se formaron <strong>{number(insightData.teams)} equipos</strong> y <strong>{number(insightData.namedProjects)} proyectos recibieron un nombre</strong>. Entre una cifra y la otra hubo bocetos, cambios de idea, primeros repositorios y presentaciones rehechas a última hora.</p>
        <p>Muchos empezaron por conocerse y aprender a trabajar juntos en horas, no en semanas. Esa coordinación también formaba parte del hackathon. Hubo <strong>29 equipos de cinco personas, 20 de cuatro y nueve de tres</strong>; dos participantes construyeron por su cuenta. En total, 254 personas encontraron su sitio en los 60 equipos.</p>
      </section>

      <aside class="pullquote reading-width">
        <blockquote>«Parecía que hubiéramos traído un trozo de San Francisco a España».</blockquote>
        <p><a href="https://es.linkedin.com/posts/domenecmele_este-fin-de-semana-fue-hackspain-conseguimos-activity-7508197420590096384-gcCL" target="_blank" rel="noopener noreferrer">Domenec Mele ↗</a> · The Exponential Fellowship</p>
      </aside>

      <section class="reading-width prose chapter" aria-labelledby="build-heading">
        <h2 id="build-heading">La noche también fue parte del hackathon.</h2>
        <p>La UPM fue el punto de encuentro, pero el trabajo se extendió más allá. En el <strong>Night Hack</strong>, Embat abrió sus oficinas a todos los participantes. A pesar de la hora, la gente seguía <em>on fire</em>: equipos construyendo, mentores ayudando y organizadores trayendo comida para mantener el ritmo.</p>
        <p>El fin de semana dejó <strong>{number(totals.pushes)} pushes y {number(totals.pullRequests)} pull requests</strong>. Las herramientas de IA procesaron <strong>{tokenBillions} mil millones de tokens</strong> en <strong>{number(totals.sessions)} sesiones</strong>, contando la caché. trace-it, por ejemplo, sumó 488 pushes y 227 pull requests antes de la demo.</p>
      </section>

      <figure class="chart-figure wide-width" aria-labelledby="chart-heading">
        <div class="figure-heading"><div><h3 id="chart-heading">Así avanzó el trabajo con IA</h3></div><p>Solicitudes por intervalo</p></div>
        <div class="chart-scroll" tabindex="0" role="region" aria-label="Gráfico de solicitudes, desplazar horizontalmente en pantallas pequeñas">
          <svg viewBox="0 0 970 320" role="img" aria-labelledby="chart-title chart-desc">
            <title id="chart-title">Solicitudes de IA en 24 intervalos durante HackSpain 2026</title>
            <desc id="chart-desc">La actividad continúa durante ambas noches y alcanza su máximo en el intervalo que comienza el sábado a las {dateTime(peakStartsAt, { hour: "2-digit", minute: "2-digit" })}.</desc>
            {[0, 0.25, 0.5, 0.75, 1].map((ratio) => <g><line x1="48" x2="928" y1={chartTop + chartHeight * (1 - ratio)} y2={chartTop + chartHeight * (1 - ratio)} class="grid-line" /><text x="38" y={chartTop + chartHeight * (1 - ratio) + 4} text-anchor="end" class="axis-label">{number(Math.round(chartMax * ratio / 1000))}k</text></g>)}
            <polygon points={chartArea} class="chart-area" />
            <polyline points={chartLine} class="chart-line" />
            <circle cx={chartPoints[peakIndex].x} cy={chartPoints[peakIndex].y} r="7" class="peak-dot" />
            {chartTicks.map((tick) => <text x={tick.x} y="298" text-anchor={tick.index === 0 ? "start" : tick.index === 23 ? "end" : "middle"} class="axis-label">{tick.label}</text>)}
          </svg>
        </div>
        <figcaption>La actividad continuó durante las dos noches. El tramo más intenso empezó el sábado a las {dateTime(peakStartsAt, { hour: "2-digit", minute: "2-digit" })}, con <strong>{number(chartMax)} solicitudes</strong> en {Math.round(bucketDuration / 60_000)} minutos. La gráfica recoge las herramientas conectadas durante la ventana medida, no todo el trabajo del evento.</figcaption>
      </figure>

      <aside class="leaders reading-width" aria-labelledby="leaders-heading">
        <h3 id="leaders-heading">Los equipos y participantes que más movieron el código</h3>
        <div class="leader-grid">
          <div><h4>Equipos</h4><ol>{insightData.githubLeaders.teams.map((leader) => <li><span>{leader.name}</span><strong>{number(leader.pushes + leader.pullRequests)}</strong></li>)}</ol></div>
          <div><h4>Participantes</h4><ol>{insightData.githubLeaders.people.map((leader) => <li><span>{leader.name}</span><strong>{number(leader.pushes + leader.pullRequests)}</strong></li>)}</ol></div>
        </div>
        <p class="leader-note">Pushes + pull requests entre el 18 y el 20 de septiembre.</p>
      </aside>

      <section class="reading-width prose chapter" aria-labelledby="mentors-heading">
        <h2 id="mentors-heading">Los mentores no se limitaron a pasar por el escenario.</h2>
        <p>Entre las más de 50 personas que compartieron experiencia estaban <strong>Miguel Carranza</strong>, cofundador y CTO de RevenueCat; <strong>Mark Villacampa</strong>, ingeniero sénior de la misma empresa; <strong>Joan Rodríguez</strong>, fundador de Quiver AI; y <strong>David Gomes</strong>, ingeniero de software en SpaceX. También pasaron perfiles como Maex Ament y Guillermo García Cobo. Y se dejó caer <a href="https://x.com/XMihura" target="_blank" rel="noopener noreferrer">XMihura</a>, famoso experto en lectores de PDFs, firmando PDFs 😉. <a href="/mentores">Conoce a los mentores ↗</a></p>
        <p>Pasaron a lo largo de todo el fin de semana. Los equipos recibieron <em>early thoughts</em> sobre proyectos todavía en construcción y pudieron hablar cara a cara con referentes a los que admiraban. Para muchos chavales, conocerlos y verlos implicarse de cerca fue una forma de imaginar hasta dónde podían llegar ellos también.</p>
      </section>

      <div class="reading-width prose figure-bridge">
        <p>Y el aprendizaje también estaba al otro lado de la mesa. Entre las personas con equipo había <strong>65 AI Engineers, 41 estudiantes y 39 Full-stack Developers</strong>, junto a perfiles de datos, producto, investigación y diseño. Sus intereses se cruzaban: 204 habían marcado agentes de IA y 171, startups. Había mucho terreno común para empezar una conversación.</p>
      </div>

      <CommunityProfiles />

      <section class="reading-width prose chapter" aria-labelledby="models-heading">
        <h2 id="models-heading">La IA acompañó ideas muy diferentes.</h2>
        <p>Construir tan deprisa también significó probar herramientas. Claude Code, Codex, Devin, OpenCode y otras aparecieron en la actividad del fin de semana. Detrás hubo modelos de varias familias: Claude, GPT, Gemini, GLM y DeepSeek. <strong>Claude Opus 5 fue el modelo identificado con más solicitudes</strong> en este conjunto.</p>
        <p>Muchos equipos pasaron de un modelo a otro según lo que necesitaban resolver en cada momento. Los gráficos dejan ver esa mezcla.</p>
      </section>

      <figure class="table-figure model-figure wide-width" aria-labelledby="models-table-heading">
        <div class="figure-heading"><div><h3 id="models-table-heading">Modelos más usados</h3></div><p>Los 10 primeros por solicitudes</p></div>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Tabla de modelos, desplazar horizontalmente en pantallas pequeñas">
          <table>
            <thead><tr><th scope="col">#</th><th scope="col">Modelo</th><th scope="col">Familia</th><th scope="col">Solicitudes</th><th scope="col">Del total</th></tr></thead>
            <tbody>{models.map((model, index) => <tr class:list={{ featured: index === 0 }}><td class="model-rank">{String(index + 1).padStart(2, "0")}</td><th scope="row">{displayModel(model.name)}</th><td>{displayFamily(model)}</td><td>{number(model.requests)}</td><td><span class="share"><span class="share-track"><span style={`width:${(model.requests / models[0].requests) * 100}%`}></span></span><span>{requestShare(model.requests)}</span></span></td></tr>)}</tbody>
          </table>
        </div>
        <figcaption>Estos diez modelos reúnen el {modelCoverage} % de las solicitudes observadas. Los porcentajes toman como base toda la actividad con IA que pudimos medir; algunos usos no identifican un modelo concreto.</figcaption>
      </figure>

      <div class="reading-width prose figure-bridge">
        <p>La lista general solo cuenta una parte de la historia. Claude Code se apoyó sobre todo en Opus; en Codex destacaron Astra y Sol; OpenCode y Pi repartieron su actividad entre varias familias. El siguiente mapa permite ver esas diferencias dentro de cada herramienta.</p>
      </div>

      <figure class="heatmap-figure wide-width" aria-labelledby="heatmap-heading">
        <div class="figure-heading"><div><h3 id="heatmap-heading">Qué modelos aparecieron en cada herramienta</h3></div><p>Porcentaje de uso dentro de cada herramienta</p></div>
        <p class="scroll-hint heatmap-hint">Desplázate horizontalmente para ver todos los modelos <span aria-hidden="true">→</span></p>
        <div class="heatmap-scroll" tabindex="0" role="region" aria-label="Mapa de calor de herramientas y modelos, desplazar horizontalmente en pantallas pequeñas">
          <table class="heatmap-table">
            <thead><tr><th scope="col">Herramienta</th>{modelLabels.map((label) => <th scope="col"><span class="model-label">{displayModel(label)}</span></th>)}</tr></thead>
            <tbody>{modelToolMatrix.map((tool) => <tr><th scope="row">{toolNames[tool.name] ?? tool.name}<small>{number(tool.total)} solicitudes</small></th>{tool.counts.map((count, index) => <td class:list={{ empty: count === 0 }} style={`--heat:${matrixTint(count, tool.total)}%`} title={`${modelLabels[index]} · ${number(count)} ${count === 1 ? "solicitud" : "solicitudes"} · ${matrixPercent(count, tool.total)}`}><span>{matrixPercent(count, tool.total)}</span></td>)}</tr>)}</tbody>
          </table>
        </div>
        <figcaption>Una celda más intensa significa que el modelo tuvo más peso <em>dentro de esa herramienta</em>. Los colores se leen por fila; no comparan el volumen absoluto entre herramientas. «Otros modelos» reúne variantes menos frecuentes y «Sin identificar», usos sin modelo concreto disponible.</figcaption>
      </figure>

      <section class="reading-width prose chapter" aria-labelledby="finish-heading">
        <h2 id="finish-heading">De las demos a la final.</h2>
        <p>Después de las noches de trabajo, tocaba elegir qué mostrar y contarlo en pocos minutos. De los <strong>{number(insightData.teams)} equipos</strong>, <strong>{number(insightData.namedProjects)} dieron nombre a su proyecto</strong>. El jurado general probó las entregas y evaluó los proyectos para seleccionar a los finalistas. Cada startup eligió además al equipo ganador de su track, con un premio propio.</p>
        <p>La final reunió a los proyectos seleccionados ante un jurado de cinco fondos: <strong>JME Ventures, Enzo Ventures, Acurio Ventures, Kfund y Kibo Ventures</strong>. El <a href="/gran-premio">gran premio de 5.000 €</a> fue para <a href="https://es.linkedin.com/posts/alejandra-rubira-posse-de-riobo%C3%B3-987b95145_el-equipo-de-mafer-ai-gan%C3%B3-los-5k-este-finde-activity-7508145203854188544-MPQ4" target="_blank" rel="noopener noreferrer">mafer AI</a>.</p>
        <figure class="awards-photo">
          <img src="/images/2026-insights/entrega-premios.webp" alt="Los equipos en el escenario durante la entrega de premios de HackSpain, con el cheque del gran premio de 5.000 euros." width="1600" height="1200" loading="lazy" decoding="async" />
          <figcaption>La entrega de premios, después de un fin de semana construyendo.</figcaption>
        </figure>
        <details class="winners-accordion">
          <summary>Ver ganadores de los cinco tracks <span class="accordion-icon" aria-hidden="true">+</span></summary>
          <ol class="winners-list">
            {trackWinners.map((winner, index) => <li>
              <span class="winner-index">{String(index + 1).padStart(2, "0")}</span>
              <div><h3>{winner.track} · {winner.project}</h3><p>{winner.description}</p><a href={winner.source} target="_blank" rel="noopener noreferrer">Ver la publicación del equipo <span aria-hidden="true">↗</span></a></div>
            </li>)}
          </ol>
        </details>
        <p>Las últimas horas se notaron también en las entregas: <strong>37 proyectos llegaron en los diez minutos entre las 10:50 y las 11:00 del domingo</strong>. Después de un fin de semana de trabajo, ese fue el momento en que muchas ideas quedaron listas para enseñarse.</p>
      </section>

      <div class="reading-width prose figure-bridge">
        <p>La variedad se ve en los repositorios: Python, TypeScript, Tailwind, Vite y FastAPI aparecen entre las tecnologías más frecuentes. No hay una receta única para llegar a una demo; cada equipo combinó lo que sabía con lo que aprendió sobre la marcha.</p>
      </div>

      <figure class="stack-figure wide-width" aria-labelledby="stack-heading">
        <div class="figure-heading"><div><h3 id="stack-heading">Tecnologías que más aparecieron</h3></div><p>Equipos con cada tecnología</p></div>
        <div id="technology-list" class="stack-list">{stacks.map((stack, index) => <div class="stack-row"><span class="stack-rank">{String(index + 1).padStart(2, "0")}</span><span class="stack-name">{stack.name}</span><span class="stack-bar"><span style={`width:${(stack.count / insightData.stacksDetected) * 100}%`}></span></span><strong>{stack.count}</strong></div>)}</div>
        <nav class="stack-pagination" aria-label="Páginas de tecnologías" hidden>
          <button type="button" data-stack-prev aria-label="Página anterior de tecnologías" aria-controls="technology-list">← Anterior</button>
          <span data-stack-status role="status" aria-live="polite" aria-atomic="true"></span>
          <button type="button" data-stack-next aria-label="Página siguiente de tecnologías" aria-controls="technology-list">Siguiente →</button>
        </nav>
        <figcaption>Equipos que usaron cada tecnología entre los {number(insightData.stacksDetected)} proyectos con información técnica disponible. Un mismo proyecto puede aparecer en varias filas.</figcaption>
      </figure>

      <section class="reading-width prose conclusion" aria-labelledby="end-heading">
        <h2 id="end-heading">Queda una comunidad que ya se conoce.</h2>
        <p>La mejor señal de lo que pasó no está en un ranking. Está en quienes se quedaron para ayudar a otro equipo, en los mentores que prolongaron la noche y en participantes que ahora saben que pueden construir algo real con personas que acababan de conocer. Varios salieron con más ganas de construir y con compañeros a los que, después de seguirlos en internet, por fin habían conocido cara a cara.</p>
        <p>Gracias a los participantes, mentores, empresas, jurado, voluntarios y a la universidad por abrir ese espacio. HackSpain 2026 duró un fin de semana, pero para muchos fue el principio. De aquí saldrán futuros founders e ingenieros que cambiarán el mundo. <a href="/comunidad">Revive el vídeo y las historias de la comunidad ↗</a></p>
      </section>

      <p class="article-note reading-width"><strong>Notas y fuentes.</strong> Cifras del evento y publicaciones públicas de los equipos, del 18 al 20 de septiembre de 2026. Las gráficas de IA reflejan la actividad registrada durante el hackathon.</p>
    </article>
  </main>
</Layout>

<script>
  const pagination = document.querySelector<HTMLElement>(".stack-pagination");
  const rows = Array.from(document.querySelectorAll<HTMLElement>(".stack-row"));
  const previous = pagination?.querySelector<HTMLButtonElement>("[data-stack-prev]");
  const next = pagination?.querySelector<HTMLButtonElement>("[data-stack-next]");
  const status = pagination?.querySelector<HTMLElement>("[data-stack-status]");
  const pageSize = 10;
  const pageCount = Math.ceil(rows.length / pageSize);

  if (pagination && previous && next && status && pageCount > 1) {
    let page = 0;
    const renderPage = () => {
      rows.forEach((row, index) => {
        row.hidden = Math.floor(index / pageSize) !== page;
      });
      previous.disabled = page === 0;
      next.disabled = page === pageCount - 1;
      status.textContent = `${page + 1} / ${pageCount}`;
    };
    previous.addEventListener("click", () => {
      page = Math.max(0, page - 1);
      renderPage();
    });
    next.addEventListener("click", () => {
      page = Math.min(pageCount - 1, page + 1);
      renderPage();
    });
    renderPage();
    pagination.hidden = false;
  }
</script>

