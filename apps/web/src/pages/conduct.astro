---
export const prerender = true;

import SignupNavbar from "../components/nav/signup-navbar.astro";
import { ConductPage } from "../components/pages/conduct-page";
import { CONDUCT_KEYWORDS, conductSeo } from "../data/landing-meta";
import Layout from "../layouts/layout.astro";

const seo = conductSeo();
---

<Layout
  sectionIndex={0}
  allowScroll
  title={seo.title}
  description={seo.description}
  ogImageAlt={seo.ogImageAlt}
  canonicalPathOverride="/conduct"
  keywordsOverride={CONDUCT_KEYWORDS}
>
  <main id="main" class="relative min-h-dvh w-full">
    <div class="relative z-10 mx-auto max-w-5xl px-3 pt-6 sm:px-4 sm:pt-10">
      <SignupNavbar />
    </div>
    <ConductPage client:load />
  </main>
</Layout>
