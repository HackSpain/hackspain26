---
import { and, eq, inArray, isNull } from "drizzle-orm";
import Logo from "../assets/logo.svg";
import { getDb } from "../db";
import { hackathonPreSignups, hackathonSignups } from "../db/schema";
import Layout from "../layouts/layout.astro";
import { sendSignupCancellationLink } from "../lib/signup-cancellation-link";

export const prerender = false;

type PageState =
  | "already_cancelled"
  | "cancelled"
  | "confirm"
  | "invalid"
  | "pre_signup_already_cancelled"
  | "pre_signup_cancelled"
  | "pre_signup_confirm"
  | "request"
  | "request_submitted";

const UUID_PATTERN =
  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
const EMAIL_MAX_LENGTH = 320;

const requestUrl = new URL(Astro.request.url);
let token = requestUrl.searchParams.get("token")?.trim() ?? "";
let preSignupToken =
  requestUrl.searchParams.get("pre_signup_token")?.trim() ?? "";
let formAction = "";
let requestedEmail = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const submittedAction = formData.get("action");
  const submittedToken = formData.get("token");
  const submittedPreSignupToken = formData.get("pre_signup_token");
  const submittedEmail = formData.get("email");
  formAction = typeof submittedAction === "string" ? submittedAction : "";
  token = typeof submittedToken === "string" ? submittedToken.trim() : "";
  preSignupToken =
    typeof submittedPreSignupToken === "string"
      ? submittedPreSignupToken.trim()
      : "";
  requestedEmail =
    typeof submittedEmail === "string"
      ? submittedEmail.trim().toLowerCase()
      : "";
}

let fullName = "";
let emailError = "";
let state: PageState = token || preSignupToken ? "invalid" : "request";

if (Astro.request.method === "POST" && formAction === "request_link") {
  const emailIsValid =
    requestedEmail.length <= EMAIL_MAX_LENGTH &&
    EMAIL_PATTERN.test(requestedEmail);

  if (emailIsValid) {
    state = "request_submitted";
    try {
      await sendSignupCancellationLink(requestedEmail);
    } catch {
      console.error("[signup-cancellation] Failed to send cancellation link");
    }
  } else {
    emailError = "Introduce un email válido.";
  }
}

if (preSignupToken && UUID_PATTERN.test(preSignupToken)) {
  const db = getDb();

  if (Astro.request.method === "POST" && formAction === "cancel_pre_signup") {
    const [cancelledPreSignup] = await db
      .update(hackathonPreSignups)
      .set({ cancelledAt: new Date() })
      .where(
        and(
          eq(hackathonPreSignups.cancellationToken, preSignupToken),
          isNull(hackathonPreSignups.cancelledAt),
          isNull(hackathonPreSignups.signupCompletedAt)
        )
      )
      .returning({ fullName: hackathonPreSignups.fullName });

    if (cancelledPreSignup) {
      fullName = cancelledPreSignup.fullName;
      state = "pre_signup_cancelled";
    }
  }

  if (state !== "pre_signup_cancelled") {
    const [preSignup] = await db
      .select({
        cancelledAt: hackathonPreSignups.cancelledAt,
        fullName: hackathonPreSignups.fullName,
        signupCompletedAt: hackathonPreSignups.signupCompletedAt,
      })
      .from(hackathonPreSignups)
      .where(eq(hackathonPreSignups.cancellationToken, preSignupToken))
      .limit(1);

    if (preSignup) {
      fullName = preSignup.fullName;
      if (preSignup.cancelledAt) {
        state = "pre_signup_already_cancelled";
      } else if (!preSignup.signupCompletedAt) {
        state = "pre_signup_confirm";
      }
    }
  }
} else if (token && UUID_PATTERN.test(token)) {
  const db = getDb();

  if (Astro.request.method === "POST" && formAction === "cancel") {
    const [cancelledSignup] = await db
      .update(hackathonSignups)
      .set({
        approvalStatus: "cancelled",
        cancelledAt: new Date(),
      })
      .where(
        and(
          eq(hackathonSignups.managementToken, token),
          inArray(hackathonSignups.approvalStatus, [
            "accepted",
            "confirmed",
            "pending",
            "waitlist",
          ]),
          isNull(hackathonSignups.cancelledAt)
        )
      )
      .returning({ fullName: hackathonSignups.fullName });

    if (cancelledSignup) {
      fullName = cancelledSignup.fullName;
      state = "cancelled";
    }
  }

  if (state !== "cancelled") {
    const [signup] = await db
      .select({
        approvalStatus: hackathonSignups.approvalStatus,
        cancelledAt: hackathonSignups.cancelledAt,
        fullName: hackathonSignups.fullName,
      })
      .from(hackathonSignups)
      .where(eq(hackathonSignups.managementToken, token))
      .limit(1);

    if (signup) {
      fullName = signup.fullName;
      if (
        signup.cancelledAt !== null ||
        signup.approvalStatus === "cancelled"
      ) {
        state = "already_cancelled";
      } else if (
        signup.approvalStatus === "accepted" ||
        signup.approvalStatus === "confirmed" ||
        signup.approvalStatus === "pending" ||
        signup.approvalStatus === "waitlist"
      ) {
        state = "confirm";
      }
    }
  }
}

const PAGE_TITLES: Record<PageState, string> = {
  already_cancelled: "La participación ya estaba cancelada",
  cancelled: "Participación cancelada",
  confirm: "Cancelar participación",
  invalid: "Enlace no válido",
  pre_signup_already_cancelled: "La preinscripción ya estaba cancelada",
  pre_signup_cancelled: "Preinscripción cancelada",
  pre_signup_confirm: "Cancelar preinscripción",
  request: "Cancelar participación",
  request_submitted: "Revisa tu correo",
};

const firstName = fullName.trim().split(/\s+/)[0] ?? "";
const title = PAGE_TITLES[state];
---

<Layout
  allowScroll
  canonicalPathOverride="/cancelacion"
  description="Gestiona tu participación en HackSpain 2026."
  includeStructuredData={false}
  robotsDirectives="noindex, nofollow"
  title={`${title} — HackSpain 2026`}
>
  <main
    id="main"
    class="hs-grain flex min-h-dvh items-center justify-center bg-hs-paper px-4 py-10"
  >
    <section
      class="w-full max-w-xl border-[3px] border-hs-ink bg-hs-cream p-6 shadow-[8px_8px_0_var(--color-hs-ink)] sm:p-10"
      aria-labelledby="cancel-title"
    >
      <a
        href="/"
        aria-label="Ir a la página de inicio de HackSpain"
        class="inline-block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-hs-navy"
      >
        <img src={Logo.src} width="176" height="58" alt="HackSpain">
      </a>

      <h1
        id="cancel-title"
        class="mt-8 font-bungee text-3xl leading-tight text-hs-ink sm:text-4xl"
      >
        {title}
      </h1>

      {state === "request" && (
        <>
          <p class="mt-5 text-lg leading-relaxed">
            Introduce el email con el que te inscribiste. Te enviaremos un enlace
            personal para confirmar la cancelación.
          </p>
          <form class="mt-8" method="post">
            <input name="action" type="hidden" value="request_link" />
            <label class="block font-bold" for="cancellation-email">
              Email de inscripción
            </label>
            <input
              aria-describedby={emailError ? "email-error" : undefined}
              aria-invalid={emailError ? "true" : undefined}
              autocomplete="email"
              class="mt-2 w-full border-[3px] border-hs-ink bg-white px-4 py-3 text-lg outline-none focus:border-hs-navy"
              id="cancellation-email"
              maxlength={EMAIL_MAX_LENGTH}
              name="email"
              required
              type="email"
              value={requestedEmail}
            />
            {emailError && (
              <p class="mt-2 font-bold text-hs-red" id="email-error">
                {emailError}
              </p>
            )}
            <button
              class="mt-5 inline-flex items-center justify-center border-[3px] border-hs-ink bg-hs-gold px-6 py-3 font-bungee text-hs-ink text-sm transition-[filter] hover:brightness-95 focus-visible:outline-2 focus-visible:outline-hs-navy focus-visible:outline-offset-2"
              type="submit"
            >
              Enviarme el enlace
            </button>
          </form>
        </>
      )}

      {state === "request_submitted" && (
        <>
          <p class="mt-5 text-lg leading-relaxed">
            Si existe una inscripción activa con ese email, recibirás un enlace para
            confirmar la cancelación. Puede tardar unos minutos.
          </p>
          <p class="mt-3">
            Por seguridad mostramos siempre este mismo mensaje, exista o no la
            inscripción.
          </p>
          <a
            class="mt-8 inline-flex items-center justify-center border-[3px] border-hs-ink bg-hs-gold px-6 py-3 font-bungee text-hs-ink text-sm transition-[filter] hover:brightness-95 focus-visible:outline-2 focus-visible:outline-hs-navy focus-visible:outline-offset-2"
            href="/"
          >
            Volver al inicio
          </a>
        </>
      )}

      {state === "confirm" && (
        <>
          <p class="mt-5 text-lg leading-relaxed">
            {firstName ? `Hola ${firstName}. ` : ""}
            Si confirmas, retiraremos tu solicitud o liberaremos tu plaza si ya
            había sido aceptada.
          </p>
          <p class="mt-3 font-bold">
            Esta acción no se puede deshacer desde este enlace.
          </p>
          <form class="mt-8 flex flex-col gap-3 sm:flex-row" method="post">
            <input name="action" type="hidden" value="cancel" />
            <input name="token" type="hidden" value={token} />
            <button
              class="inline-flex items-center justify-center border-[3px] border-hs-ink bg-hs-red px-6 py-3 font-bungee text-sm text-white transition-[filter] hover:brightness-90 focus-visible:outline-2 focus-visible:outline-hs-navy focus-visible:outline-offset-2"
              type="submit"
            >
              Sí, cancelar mi participación
            </button>
            <a
              class="inline-flex items-center justify-center border-[3px] border-hs-ink bg-hs-gold px-6 py-3 font-bungee text-hs-ink text-sm transition-[filter] hover:brightness-95 focus-visible:outline-2 focus-visible:outline-hs-navy focus-visible:outline-offset-2"
              href="/"
            >
              No cancelar
            </a>
          </form>
        </>
      )}

      {state === "pre_signup_confirm" && (
        <>
          <p class="mt-5 text-lg leading-relaxed">
            {firstName ? `Hola ${firstName}. ` : ""}
            Si confirmas, cancelaremos tu preinscripción y no recibirás más
            recordatorios para completar el signup.
          </p>
          <p class="mt-3 font-bold">
            Esta acción no se puede deshacer desde este enlace.
          </p>
          <form class="mt-8 flex flex-col gap-3 sm:flex-row" method="post">
            <input name="action" type="hidden" value="cancel_pre_signup" />
            <input
              name="pre_signup_token"
              type="hidden"
              value={preSignupToken}
            />
            <button
              class="inline-flex items-center justify-center border-[3px] border-hs-ink bg-hs-red px-6 py-3 font-bungee text-sm text-white transition-[filter] hover:brightness-90 focus-visible:outline-2 focus-visible:outline-hs-navy focus-visible:outline-offset-2"
              type="submit"
            >
              Sí, cancelar mi preinscripción
            </button>
            <a
              class="inline-flex items-center justify-center border-[3px] border-hs-ink bg-hs-gold px-6 py-3 font-bungee text-hs-ink text-sm transition-[filter] hover:brightness-95 focus-visible:outline-2 focus-visible:outline-hs-navy focus-visible:outline-offset-2"
              href="/"
            >
              No cancelar
            </a>
          </form>
        </>
      )}

      {state === "cancelled" && (
        <>
          <p class="mt-5 text-lg leading-relaxed">
            {firstName ? `Gracias por avisarnos, ${firstName}. ` : "Gracias por avisarnos. "}
            Tu participación ha quedado cancelada. Si ya tenías plaza, podremos
            ofrecérsela a otra persona.
          </p>
          <a
            class="mt-8 inline-flex items-center justify-center border-[3px] border-hs-ink bg-hs-gold px-6 py-3 font-bungee text-hs-ink text-sm transition-[filter] hover:brightness-95 focus-visible:outline-2 focus-visible:outline-hs-navy focus-visible:outline-offset-2"
            href="/"
          >
            Volver al inicio
          </a>
        </>
      )}

      {state === "already_cancelled" && (
        <>
          <p class="mt-5 text-lg leading-relaxed">
            No tienes que hacer nada más. Ya habíamos registrado esta cancelación.
          </p>
          <a
            class="mt-8 inline-flex items-center justify-center border-[3px] border-hs-ink bg-hs-gold px-6 py-3 font-bungee text-hs-ink text-sm transition-[filter] hover:brightness-95 focus-visible:outline-2 focus-visible:outline-hs-navy focus-visible:outline-offset-2"
            href="/"
          >
            Volver al inicio
          </a>
        </>
      )}

      {state === "pre_signup_cancelled" && (
        <>
          <p class="mt-5 text-lg leading-relaxed">
            {firstName ? `Gracias por avisarnos, ${firstName}. ` : "Gracias por avisarnos. "}
            Tu preinscripción ha quedado cancelada y no recibirás más recordatorios
            para completar el signup.
          </p>
          <a
            class="mt-8 inline-flex items-center justify-center border-[3px] border-hs-ink bg-hs-gold px-6 py-3 font-bungee text-hs-ink text-sm transition-[filter] hover:brightness-95 focus-visible:outline-2 focus-visible:outline-hs-navy focus-visible:outline-offset-2"
            href="/"
          >
            Volver al inicio
          </a>
        </>
      )}

      {state === "pre_signup_already_cancelled" && (
        <>
          <p class="mt-5 text-lg leading-relaxed">
            No tienes que hacer nada más. Ya habíamos registrado la cancelación de
            esta preinscripción.
          </p>
          <a
            class="mt-8 inline-flex items-center justify-center border-[3px] border-hs-ink bg-hs-gold px-6 py-3 font-bungee text-hs-ink text-sm transition-[filter] hover:brightness-95 focus-visible:outline-2 focus-visible:outline-hs-navy focus-visible:outline-offset-2"
            href="/"
          >
            Volver al inicio
          </a>
        </>
      )}

      {state === "invalid" && (
        <>
          <p class="mt-5 text-lg leading-relaxed">
            Este enlace no corresponde a una solicitud o plaza que se pueda cancelar.
            Comprueba que lo has copiado completo desde uno de nuestros correos.
          </p>
          <a
            class="mt-8 inline-flex items-center justify-center border-[3px] border-hs-ink bg-hs-gold px-6 py-3 font-bungee text-hs-ink text-sm transition-[filter] hover:brightness-95 focus-visible:outline-2 focus-visible:outline-hs-navy focus-visible:outline-offset-2"
            href="/cancelacion"
          >
            Solicitar otro enlace
          </a>
        </>
      )}
    </section>
  </main>
</Layout>
