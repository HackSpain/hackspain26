---
import ArrowLeftBold from "phosphor-astro/ArrowLeftBold.astro";
import { HarnessPollPage } from "../components/pages/harness-poll-page";
import { hasEventEnded } from "../data/signup-deadline";
import Layout from "../layouts/layout.astro";

export const prerender = true;

const closed = hasEventEnded();
---

<Layout
  sectionIndex={0}
  allowScroll
  title={closed ? "Encuesta cerrada — HackSpain 2026" : "Encuesta de harnesses — HackSpain 2026"}
  description={closed ? "La encuesta de harnesses de HackSpain 2026 ha terminado." : "Cuéntanos qué harnesses crees que utilizarás en HackSpain 2026."}
  canonicalPathOverride="/poll-harness"
  robotsDirectives="noindex, nofollow"
  includeStructuredData={false}
>
  <main id="main" class="min-h-dvh bg-hs-paper sm:pt-10">
    <nav
      class="mx-auto flex min-h-[3.25rem] max-w-3xl items-stretch border-hs-ink border-b-[3px] bg-hs-paper sm:border-[3px]"
      aria-label="Encuesta"
    >
      <a
        href="/"
        class="flex min-w-0 w-full items-center gap-2 px-4 py-3 font-sans text-sm font-extrabold text-hs-ink transition-colors hover:bg-hs-sand/60 sm:py-3.5"
      >
        <span class="inline-flex shrink-0 text-hs-orange" aria-hidden="true">
          <ArrowLeftBold class="h-5 w-5" />
        </span>
        <span class="truncate">HackSpain 2026</span>
      </a>
    </nav>
    {closed ? (
      <section
        class="mx-auto flex min-h-[calc(100dvh-10rem)] max-w-3xl items-center px-4 py-10 sm:px-6"
      >
        <div
          class="w-full border-[3px] border-hs-ink bg-hs-gold p-6 shadow-[8px_8px_0_var(--color-hs-ink)] sm:p-10"
        >
          <h1
            class="text-balance font-bungee text-3xl text-hs-ink leading-tight sm:text-5xl"
          >
            Encuesta cerrada
          </h1>
          <p class="mt-4 max-w-lg text-pretty font-bold text-hs-brown text-lg">
            HackSpain 2026 ya terminó. Gracias a quienes compartieron las
            herramientas que pensaban utilizar.
          </p>
        </div>
      </section>
    ) : (
      <HarnessPollPage client:load />
    )}
  </main>
</Layout>
