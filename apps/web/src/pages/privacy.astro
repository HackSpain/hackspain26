---
export const prerender = true;

import SignupNavbar from "../components/nav/signup-navbar.astro";
import { PrivacyPage } from "../components/pages/privacy-page";
import { privacySeo } from "../data/landing-meta";
import Layout from "../layouts/layout.astro";

const seo = privacySeo();
---

<Layout
  sectionIndex={0}
  allowScroll
  title={seo.title}
  description={seo.description}
  ogImageAlt={seo.ogImageAlt}
  canonicalPathOverride="/privacy"
>
  <main id="main" class="relative min-h-dvh w-full">
    <div class="relative z-10 mx-auto max-w-5xl px-3 pt-6 sm:px-4 sm:pt-10">
      <SignupNavbar />
    </div>
    <PrivacyPage client:load />
  </main>
</Layout>
