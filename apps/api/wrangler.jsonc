{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hackspain-provider-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "api.hackspain.com", "custom_domain": true }],
  "vars": { "RAWTREE_PROXY_TABLE": "hackspain_proxy_usage" },
  "secrets": { "required": ["RAWTREE_API_KEY", "RAWTREE_DATABASE"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
