{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": [
      "src/**",
      "convex/**",
      "next.config.ts",
      "!convex/_generated/**"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.module.css"],
      "css": {
        "parser": {
          "cssModules": true
        }
      }
    }
  ],
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  }
}
