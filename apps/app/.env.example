NEXT_PUBLIC_CONVEX_URL=

# Better Stack Errors uses the Sentry-compatible SDK. The DSN is public.
NEXT_PUBLIC_BETTER_STACK_ERRORS_DSN=
# Better Stack Telemetry source used for structured logs and Web Vitals.
NEXT_PUBLIC_BETTER_STACK_SOURCE_TOKEN=
NEXT_PUBLIC_BETTER_STACK_INGESTING_URL=
NEXT_PUBLIC_BETTER_STACK_PROXY_PATH=/betterstack
NEXT_PUBLIC_BETTER_STACK_LOG_LEVEL=info
# Source-map upload values from Errors -> application -> Advanced settings.
BETTER_STACK_API_TOKEN=
BETTER_STACK_ERRORS_ORG=
BETTER_STACK_ERRORS_PROJECT=
BETTER_STACK_SOURCEMAPS_URL=

# Also set these on the Convex deployment (`npx convex env set` from apps/app).
RESEND_API_KEY=
RESEND_FROM="HackSpain <noreply@updates.hackspain.com>"
# AUTH_RESEND_KEY and AUTH_EMAIL still work as fallbacks.
ADMIN_EMAILS=
MIGRATION_SECRET=
# Dashboard URL. Used to send the user back after linking GitHub.
SITE_URL=http://localhost:3000

# GitHub OAuth App for linking accounts. The callback goes directly to the
# Convex HTTP action at <CONVEX_SITE_URL>/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Required for the feed's GitHub polling (convex/githubFeed.ts). A classic token with
# no scopes, or a fine-grained token with public repo read, is enough; it only lifts
# the rate limit from 60/hour (shared per IP) to 5000/hour.
GITHUB_TOKEN=

# Server-only OTLP storage for CLI telemetry. RawTree writes every event to
# `hackspain_otel_logs` using this read_write key.
RAWTREE_API_KEY=
RAWTREE_DATABASE=
# RAWTREE_BASE_URL=https://api.rawtree.com
# The TV's insight boxes read AI usage back from the OTLP logs table through
# /api/tv/insights. Unset = the boxes show "Sin datos".

# Dev only. When RESEND_API_KEY is unset, 00000000 also works as the email sign-in code.
# ALLOW_EMAIL_OTP_STUB=true
