NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Also set these on the Convex deployment (`npx convex env set` from apps/app).
AUTH_RESEND_KEY=
AUTH_EMAIL=HackSpain <onboarding@resend.dev>
ADMIN_EMAILS=
MIGRATION_SECRET=
# Dashboard URL. Used to send the user back after linking GitHub.
SITE_URL=http://localhost:3000

# GitHub OAuth App for linking accounts. Callback URL on GitHub must be
# <CONVEX_SITE_URL>/github/callback (the *.convex.site URL, not the dashboard).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Required for the feed's GitHub polling (convex/githubFeed.ts). A classic token with
# no scopes, or a fine-grained token with public repo read, is enough; it only lifts
# the rate limit from 60/hour (shared per IP) to 5000/hour.
GITHUB_TOKEN=

# Dev only. When AUTH_RESEND_KEY is unset, 00000000 also works as the email sign-in code.
# ALLOW_EMAIL_OTP_STUB=true

# Optional. Set all three to deliver phone codes via Twilio SMS. Without
# Twilio, phone verification only works if the Convex env ALLOW_PHONE_STUB=true
# (dev only) — then the code is logged and shown as a stub.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# ALLOW_PHONE_STUB=true
